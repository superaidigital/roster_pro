# Roster Pro database configuration
# Configure these as environment variables in Apache/PHP or your deployment platform.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=roster_pro_db
DB_USER=roster_user
DB_PASS=change_this_in_your_environment

# Optional: only enable temporarily when running legacy automatic schema patches.
APP_AUTO_PATCH_DB=0
APP_AUTO_MIGRATE=0

# Backup security
BACKUP_DIR=/secure/path/outside/webroot/roster-pro-backups
CRON_BACKUP_KEY=generate_at_least_32_random_characters
