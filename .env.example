# Environment
APP_ENV=development
# Production example: https://roster.example.go.th/roster_pro
APP_BASE_URL=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=roster_pro_db
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+07:00

# Optional full path when mariadb-dump / mysqldump is not in PATH
DB_DUMP_BIN=
# Keep backups outside public/. Relative paths are resolved from project root.
BACKUP_DIR=storage/backups

# Deployment audit label shown in schema_migrations.applied_by
DEPLOY_ACTOR=

# Roster Pro environment configuration
# Generate a long random secret (32+ chars) in Production.
ROSTER_CRON_KEY=replace-with-a-long-random-secret

# Observability / reliability
# Run scripts/schedule_jobs.php hourly and scripts/job_worker.php every minute via cron/task scheduler.
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=5
NOTIFICATION_RETENTION_DAYS=30
OBSERVABILITY_RETENTION_DAYS=90
JOB_HISTORY_RETENTION_DAYS=30
JOB_STALE_SECONDS=600

# Performance / scalability
DASHBOARD_CACHE_TTL=20
SLOW_REQUEST_THRESHOLD_MS=1500
PERFORMANCE_CACHE_DIR=storage/cache

# Disaster Recovery / Business Continuity
# RPO: maximum acceptable backup age. Default 24 hours.
DR_MAX_RPO_SECONDS=86400
# RTO: maximum acceptable restore drill time. Default 15 minutes.
DR_MAX_RTO_SECONDS=900
# A successful restore drill should be recorded at least every 7 days.
DR_MAX_DRILL_AGE_DAYS=7
# Label used by recovery_check.php when selecting the latest routine backup.
DR_BACKUP_LABEL=scheduled
# Set to 1 in Production when DR posture should affect overall observability health.
DR_ENFORCE_HEALTH=0
# Optional admin account used only to CREATE/DROP isolated dr_drill_* databases.
DR_DB_ADMIN_USER=
DR_DB_ADMIN_PASSWORD=
# Optional database client binary used by restore_drill.php.
DB_CLIENT_BIN=mariadb
# Comma-separated tables that must exist and be queryable after a restore drill.
DR_CRITICAL_TABLES=users,hospitals,shifts,roster_status,system_settings,schema_migrations,disaster_recovery_drills
